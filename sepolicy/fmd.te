# Broadcom FM radio daemon. fmd powers the BCM4345C5 combo chip through the
# rfkill sysfs node, loads its FM firmware over the shared Bluetooth UART and
# controls the tuner through HCI vendor commands.
type fmd, domain;
type fmd_exec, exec_type, vendor_file_type, file_type;
type fmd_socket, file_type;

init_daemon_domain(fmd)

# The rfkill sysfs interface checks CAP_NET_ADMIN in addition to file access.
allow fmd self:global_capability_class_set net_admin;

# /dev/ttySAC0 (shared with the Bluetooth stack) and the FM LNA switch.
allow fmd bluetooth_device:chr_file rw_file_perms;
allow fmd sysfs_bluetooth_writable:file rw_file_perms;

# Firmware image.
r_dir_file(fmd, vendor_firmware_file)

# The listening socket object is created with the fmd domain as its SID (the
# socket line does not override the service seclabel); the socket inode is
# labeled fmd_socket.
allow fmd self:unix_stream_socket { create bind listen accept getattr read write };
allow fmd fmd_socket:sock_file rw_file_perms;

# Accepted client sockets carry the system_app SID.
allow fmd system_app:unix_stream_socket { read write getopt getattr shutdown };

# The FM radio application (system_app) is the only client.
allow system_app fmd:unix_stream_socket { connectto read write };
allow system_app fmd_socket:sock_file write;

# system_app (FMRadio) talks to this vendor daemon over /dev/socket/fmd. The
# legacy Broadcom FM JNI has no binder HAL, so this core<->vendor socket
# communication is exempted from neverallow_establish_socket_comms.
typeattribute fmd socket_between_core_and_vendor_violators;
