cc_binary {
    // Unique module name: the j5y17lte tree also provides an "fmd" daemon and
    // both device trees are parsed by Soong in the same source checkout. The
    // installed binary name stays /vendor/bin/fmd via stem.
    name: "fmd_a6lte",
    stem: "fmd",

    srcs: [
        "fmd.c",
        "fm_proto.c",
        "fm_uart.c",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    init_rc: ["fmd.rc"],

    vendor: true,
}
