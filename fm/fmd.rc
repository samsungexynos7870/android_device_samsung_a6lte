# Broadcom BCM4345C5 FM radio daemon. It owns the combo chip UART while the FM
# application is using the tuner and must therefore not run before Bluetooth
# has released it: fmd refuses to power up while rfkill reports Bluetooth as
# enabled.
service fmd /vendor/bin/fmd
    class hal
    user bluetooth
    group bluetooth
    seclabel u:r:fmd:s0
    capabilities NET_ADMIN
    socket fmd stream 0660 system system
    stdio_to_kmsg
